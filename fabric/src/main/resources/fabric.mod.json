{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/sap",
        "sources": "https://github.com/Vaneck512/SimpleAudioPlayer/"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "ru.vaneck.sap.SimpleAudioPlayer"
        ]
    },
    "custom": {
        "modmenu": {
            "badges": ["library"],
            "links": {
                "Author": "https://www.youtube.com/@vaneck512-mods"
            },
            "update_checker": true,
            "background": "sap_banner.png"
        }
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  